/**app.wxss**/
page {
  --brand: #c45c26;
  --brand-deep: #9a3f14;
  --brand-soft: #f3d7c4;
  --bg: #f4efe4;
  --bg-elevated: #fffdf8;
  --ink: #2a2318;
  --muted: #6f634f;
  --line: #e6d9c4;
  --shadow: 0 10rpx 40rpx rgba(68, 42, 18, 0.08);
  --radius: 24rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', sans-serif;
  color: var(--ink);
  background: var(--bg);
  font-size: 32rpx;
  line-height: 1.55;
}

.btn-primary {
  background: linear-gradient(135deg, #d86a2f 0%, #c45c26 55%, #a84716 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(196, 92, 38, 0.28);
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #efe4d4;
  color: var(--ink);
  font-size: 28rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--line);
}

.btn-secondary::after {
  border: none;
}
