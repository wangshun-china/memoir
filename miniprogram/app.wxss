/** Global design tokens — 适老 · 家书暖色 */
page {
  --brand: #c45c26;
  --brand-deep: #9a3f14;
  --brand-soft: #f3d7c4;
  --brand-glow: rgba(196, 92, 38, 0.28);
  --bg: #f4efe4;
  --bg-elevated: #fffdf8;
  --bg-input: #f7f1e7;
  --ink: #2a2318;
  --muted: #6f634f;
  --muted-2: #8a7b66;
  --line: #e6d9c4;
  --line-soft: #efe6d8;
  --danger: #a33;
  --success: #3d6b3a;
  --success-bg: #e8efdf;
  --shadow: 0 10rpx 40rpx rgba(68, 42, 18, 0.08);
  --shadow-sm: 0 6rpx 20rpx rgba(68, 42, 18, 0.06);
  --radius: 24rpx;
  --radius-lg: 28rpx;
  --radius-sm: 16rpx;
  --tap-min: 88rpx;
  --font-body: 34rpx;
  --font-title: 40rpx;
  --font-small: 26rpx;
  --lh: 1.6;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', sans-serif;
  color: var(--ink);
  background: var(--bg);
  font-size: var(--font-body);
  line-height: var(--lh);
}

.btn-primary {
  background: linear-gradient(135deg, #d86a2f 0%, #c45c26 55%, #a84716 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  min-height: var(--tap-min);
  line-height: var(--tap-min);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx var(--brand-glow);
  border: none;
  padding: 0 28rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.55;
}

.btn-secondary {
  background: #efe4d4;
  color: var(--ink);
  font-size: 30rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  padding: 0 24rpx;
}

.btn-secondary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: var(--brand);
  font-size: 28rpx;
  padding: 12rpx 8rpx;
  margin: 0;
  line-height: 1.4;
}

.btn-ghost::after {
  border: none;
}

.card-surface {
  background: var(--bg-elevated);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.text-muted {
  color: var(--muted);
}

.text-danger {
  color: var(--danger);
}
