/** Global design tokens — 墨香雅韵 · 书卷气息 */
page {
  --brand: #2D5A3D;
  --brand-deep: #1E3D29;
  --brand-soft: #E4EDE3;
  --brand-glow: rgba(45, 90, 61, 0.15);
  --bg: #F7F5EE;
  --bg-elevated: #FDFCF9;
  --bg-input: #F0EDE6;
  --ink: #2B2B28;
  --muted: #6B6B64;
  --muted-2: #8F8F85;
  --line: #E0DCD2;
  --line-soft: #EDEAE2;
  --danger: #8B3A3A;
  --success: #3D6B4A;
  --success-bg: #E8F0E6;
  --shadow: 0 6rpx 32rpx rgba(45, 90, 61, 0.05);
  --shadow-sm: 0 2rpx 12rpx rgba(45, 90, 61, 0.04);
  --radius: 16rpx;
  --radius-lg: 20rpx;
  --radius-sm: 12rpx;
  --tap-min: 88rpx;
  --font-body: 34rpx;
  --font-title: 42rpx;
  --font-small: 26rpx;
  --lh: 1.75;

  font-family: 'Songti SC', 'STSong', 'SimSun', 'Noto Serif SC', 'Source Han Serif SC',
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--ink);
  background: var(--bg);
  font-size: var(--font-body);
  line-height: var(--lh);
}

.btn-primary {
  background: linear-gradient(135deg, #3D6B4A 0%, #2D5A3D 55%, #1E3D29 100%);
  color: #FDFCF9;
  font-size: 34rpx;
  font-weight: 600;
  min-height: var(--tap-min);
  line-height: var(--tap-min);
  border-radius: var(--radius-sm);
  box-shadow: 0 4rpx 16rpx var(--brand-glow);
  border: none;
  padding: 0 32rpx;
  letter-spacing: 2rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-secondary {
  background: var(--bg-elevated);
  color: var(--brand);
  font-size: 30rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line);
  padding: 0 24rpx;
  letter-spacing: 1rpx;
}

.btn-secondary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: var(--brand);
  font-size: 28rpx;
  padding: 12rpx 8rpx;
  margin: 0;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.btn-ghost::after {
  border: none;
}

.card-surface {
  background: var(--bg-elevated);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.text-muted {
  color: var(--muted);
}

.text-danger {
  color: var(--danger);
}
