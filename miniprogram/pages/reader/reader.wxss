.page {
  min-height: 100vh;
  padding: 20rpx 0 40rpx;
  background: #f4efe4;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  padding: 8rpx 32rpx 16rpx;
  flex-shrink: 0;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2a2318;
}

.meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6f634f;
}

.header-actions {
  margin-top: 16rpx;
}

.btn-danger-outline {
  background: transparent !important;
  color: #a33 !important;
  border: 1rpx solid rgba(170, 51, 51, 0.45) !important;
  font-size: 24rpx !important;
  margin: 0 !important;
  padding: 0 18rpx !important;
}

.btn-danger-outline::after {
  border: none;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.action-half {
  flex: 1;
  margin: 0 !important;
  font-size: 28rpx !important;
}

.action-hint {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a7b66;
}

.tabs {
  flex-shrink: 0;
  white-space: nowrap;
  border-bottom: 1rpx solid #e6d9c4;
  background: #fffdf8;
}

.tabs-inner {
  display: inline-flex;
  padding: 12rpx 20rpx 16rpx;
  gap: 12rpx;
}

.tab {
  display: inline-flex;
  flex-direction: column;
  min-width: 140rpx;
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  background: #f7f1e7;
  border: 1rpx solid #e6d9c4;
}

.tab-on {
  background: #f3d7c4;
  border-color: #e8b48a;
}

.tab-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #2a2318;
}

.tab-status {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #8a7b66;
}

.body {
  flex: 1;
  height: 0;
  padding: 20rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.content-card {
  background: #fffdf8;
  border: 1rpx solid #e6d9c4;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(68, 42, 18, 0.05);
}

.content-text {
  font-size: 30rpx;
  line-height: 1.75;
  color: #2a2318;
  white-space: pre-wrap;
}

.empty-card {
  background: #fffdf8;
  border: 1rpx dashed #e0d2bc;
  border-radius: 20rpx;
  padding: 40rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2a2318;
}

.empty-desc {
  display: block;
  margin: 12rpx 0 28rpx;
  font-size: 26rpx;
  color: #6f634f;
  line-height: 1.5;
}

.state {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #6f634f;
}

.error {
  color: #a33;
}
