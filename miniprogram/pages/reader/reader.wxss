.page {
  min-height: 100vh;
  padding: 12rpx 0 0;
  background: var(--bg);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  padding: 8rpx 28rpx 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.header-main {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.header-more {
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--muted-2);
  flex-shrink: 0;
}

.progress-line {
  padding: 0 28rpx 10rpx;
  flex-shrink: 0;
}

.progress-text {
  font-size: 22rpx;
  color: var(--muted-2);
}

.tabs {
  flex-shrink: 0;
  white-space: nowrap;
  border-bottom: 1rpx solid var(--line);
  background: var(--bg-elevated);
}

.tabs-inner {
  display: inline-flex;
  padding: 14rpx 20rpx 16rpx;
  gap: 12rpx;
}

.tab {
  display: inline-flex;
  flex-direction: column;
  min-width: 148rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--line);
}

.tab-on {
  background: var(--brand-soft);
  border-color: #e8b48a;
  box-shadow: 0 4rpx 12rpx rgba(196, 92, 38, 0.12);
}

.tab.has-draft .tab-status {
  color: var(--success);
}

.tab-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.tab-status {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--muted-2);
}

.body {
  flex: 1;
  height: 0;
  padding: 20rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.content-card.paper {
  background: linear-gradient(180deg, #fffdf8 0%, #fbf6ec 100%);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 32rpx 28rpx 36rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.content-card.paper::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: linear-gradient(180deg, #e8a878, var(--brand));
}

.chapter-name {
  display: block;
  font-size: 28rpx;
  font-weight: 650;
  color: var(--brand-deep);
  margin-bottom: 16rpx;
  padding-left: 12rpx;
}

.content-text {
  font-size: 34rpx;
  line-height: 1.85;
  color: var(--ink);
  white-space: pre-wrap;
  padding-left: 12rpx;
}

.empty-card {
  padding: 40rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty-desc {
  display: block;
  margin: 14rpx 0 0;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.6;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.action-half {
  flex: 1;
  margin: 0 !important;
  font-size: 30rpx !important;
}

.action-hint {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted-2);
}

.state {
  padding: 80rpx 32rpx;
  text-align: center;
  color: var(--muted);
  font-size: 30rpx;
}

.error {
  color: var(--danger);
}
