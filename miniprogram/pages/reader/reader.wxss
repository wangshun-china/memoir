.page {
  min-height: 100vh;
  padding: 16rpx 0 0;
  background: var(--bg);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  padding: 12rpx 28rpx 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.header-main {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand-deep);
  letter-spacing: 2rpx;
}

.meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.header-more {
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--muted-2);
  flex-shrink: 0;
}

.progress-line {
  padding: 0 28rpx 12rpx;
  flex-shrink: 0;
}

.progress-text {
  font-size: 22rpx;
  color: var(--muted-2);
  letter-spacing: 1rpx;
}

.tabs {
  flex-shrink: 0;
  white-space: nowrap;
  border-bottom: 1rpx solid var(--line);
  background: var(--bg-elevated);
}

.tabs-inner {
  display: inline-flex;
  padding: 16rpx 20rpx 18rpx;
  gap: 14rpx;
}

.tab {
  display: inline-flex;
  flex-direction: column;
  min-width: 148rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-input);
  border: 1rpx solid var(--line);
}

.tab-on {
  background: var(--brand-soft);
  border-color: var(--brand);
}

.tab.has-draft .tab-status {
  color: var(--success);
}

.tab-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.tab-status {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--muted-2);
  letter-spacing: 1rpx;
}

.body {
  flex: 1;
  height: 0;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.content-card.paper {
  background: var(--bg-elevated);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 36rpx 32rpx 40rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.content-card.paper::before {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 4rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: var(--brand);
}

.chapter-name {
  display: block;
  font-size: 30rpx;
  font-weight: 650;
  color: var(--brand);
  margin-bottom: 20rpx;
  padding-left: 14rpx;
  letter-spacing: 2rpx;
}

.content-text {
  font-size: 34rpx;
  line-height: 2.0;
  color: var(--ink);
  white-space: pre-wrap;
  padding-left: 14rpx;
  letter-spacing: 1rpx;
}

.empty-card {
  padding: 48rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.empty-desc {
  display: block;
  margin: 16rpx 0 0;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.action-half {
  flex: 1;
  margin: 0 !important;
  font-size: 30rpx !important;
}

.action-hint {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted-2);
  letter-spacing: 1rpx;
}

.storybox-btn {
  width: 100%;
  margin: 24rpx 0 0 !important;
}

.state {
  padding: 80rpx 32rpx;
  text-align: center;
  color: var(--muted);
  font-size: 30rpx;
  letter-spacing: 1rpx;
}

.error {
  color: var(--danger);
}
