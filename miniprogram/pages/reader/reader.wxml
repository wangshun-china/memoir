<navigation-bar title="回忆录正文" back="{{true}}" color="black" background="#F4EFE4"></navigation-bar>

<view class="page">
  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <block wx:else>
    <view class="header">
      <view class="header-main">
        <text class="title">{{memoirTitle}}</text>
        <text class="meta">主人 · {{subjectName}}</text>
      </view>
      <text class="header-more" bindtap="onMore">···</text>
    </view>

    <view class="progress-line">
      <text class="progress-text">章节目录 · {{draftCount}}/{{chapters.length}} 章有草稿</text>
    </view>

    <!-- 章节目录：横向大标签，便于点选 -->
    <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
      <view class="tabs-inner">
        <view
          wx:for="{{chapters}}"
          wx:key="id"
          class="tab {{item.id === activeId ? 'tab-on' : ''}} {{item.hasDraft ? 'has-draft' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectChapter"
        >
          <text class="tab-title">{{item.title}}</text>
          <text class="tab-status">{{item.statusLabel}}</text>
        </view>
      </view>
    </scroll-view>

    <scroll-view scroll-y class="body">
      <view wx:if="{{activeContent}}" class="content-card paper">
        <text class="chapter-name">{{activeTopic}}</text>
        <text class="content-text">{{activeContent}}</text>
      </view>
      <view wx:else class="empty-card card-surface">
        <text class="empty-title">{{activeHasInterview ? '还没整理成文' : '这一章还没开始'}}</text>
        <text class="empty-desc" wx:if="{{activeHasInterview}}">
          已有采访记录。可以继续补充，或点「生成本章」整理成草稿。
        </text>
        <text class="empty-desc" wx:else>
          点下方「去采访」，和采访者一问一答慢慢说。
        </text>
      </view>

      <view class="action-row">
        <button class="btn-primary action-half" bindtap="onGoInterview">
          {{activeHasInterview ? '继续采访' : '去采访'}}
        </button>
        <button
          class="btn-secondary action-half"
          loading="{{generating}}"
          disabled="{{!activeHasInterview || generating}}"
          bindtap="onGenerate"
        >生成本章</button>
      </view>
      <text wx:if="{{activeHasInterview && !activeContent}}" class="action-hint">
        生成不会清空对话，只整理成章节文字。
      </text>
    </scroll-view>
  </block>
</view>
