.page {
  padding: 16rpx 28rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.tab {
  flex: 1;
  min-width: 140rpx;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  background: var(--bg-elevated);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--muted);
}

.tab.on {
  background: var(--brand-soft);
  color: var(--brand-deep);
  border-color: var(--brand);
  font-weight: 600;
}

.card-surface {
  background: var(--bg-elevated);
  border: 1rpx solid var(--line-soft);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat {
  padding: 28rpx 24rpx;
  text-align: center;
}

.stat .n {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand-deep);
}

.stat .l {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.block {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.wechat-card {
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.wechat-card .hint {
  margin-bottom: 20rpx;
}

.wechat-card .btn-secondary {
  width: 100%;
}

.block-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.line {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  word-break: break-all;
}

.row {
  padding: 22rpx 24rpx;
  margin-bottom: 12rpx;
}

.row-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.row-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted-2);
}

.form {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: var(--muted-2);
  margin-bottom: 16rpx;
}

.input {
  background: var(--bg-input);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  margin-bottom: 14rpx;
}

.thinking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 4rpx 20rpx;
}

.thinking-copy {
  flex: 1;
  min-width: 0;
}

.thinking-label {
  display: block;
  font-size: 30rpx;
  font-weight: 550;
  color: var(--ink);
}

.thinking-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted-2);
}

.form .btn-primary,
.form .btn-secondary {
  width: 100%;
  margin-top: 8rpx;
}

.test-out {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  white-space: pre-wrap;
  color: var(--ink);
}

.usage {
  display: block;
  font-size: 22rpx;
  color: var(--muted-2);
  margin-top: 8rpx;
  word-break: break-all;
}

.state {
  text-align: center;
  padding: 48rpx 24rpx;
}

.muted {
  color: var(--muted);
  font-size: 28rpx;
}

.error-box {
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  color: var(--danger);
  font-size: 26rpx;
}
