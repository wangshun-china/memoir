.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 120rpx;
  background: var(--bg);
  box-sizing: border-box;
}

.profile-card {
  background: var(--bg-elevated);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  padding: 48rpx 36rpx 40rpx;
  text-align: center;
  box-shadow: var(--shadow);
  margin-bottom: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  letter-spacing: 1rpx;
}

.avatar.big {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
  font-size: 56rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0 auto 20rpx;
  background: transparent;
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  line-height: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
  display: block;
}

.name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand-deep);
  letter-spacing: 2rpx;
}

.name-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 0 auto 10rpx;
  padding: 8rpx 16rpx;
}

.name-text {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand-deep);
  letter-spacing: 2rpx;
}

.name-edit-hint {
  font-size: 22rpx;
  color: var(--brand);
  padding: 6rpx 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}

.name-input {
  display: block;
  margin: 0 auto 10rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  width: 80%;
  letter-spacing: 2rpx;
}

.desc {
  display: block;
  margin: 12rpx 0 24rpx;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.stat-row {
  display: flex;
  justify-content: center;
  margin-top: 10rpx;
}

.stat-item {
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 18rpx 40rpx;
  min-width: 160rpx;
}

.stat-n {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.1;
}

.stat-l {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.login-btn {
  width: 100%;
  margin-top: 10rpx;
}

.login-form {
  margin: 18rpx 0 10rpx;
  text-align: left;
}

.login-input {
  background: var(--bg-input);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 16rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.login-divider {
  position: relative;
  text-align: center;
  margin: 20rpx 0 14rpx;
}

.login-divider::before {
  content: '';
  position: absolute;
  left: 10%;
  right: 10%;
  top: 50%;
  height: 1rpx;
  background: var(--line);
}

.login-divider-text {
  position: relative;
  background: var(--bg-elevated);
  padding: 0 16rpx;
  font-size: 22rpx;
  color: var(--muted-2);
  letter-spacing: 1rpx;
}

.login-link {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--brand);
  letter-spacing: 1rpx;
}

.menu {
  overflow: hidden;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 28rpx;
  border-bottom: 1rpx solid var(--line-soft);
  min-height: var(--tap-min);
  box-sizing: border-box;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-label {
  font-size: 32rpx;
  color: var(--ink);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.menu-extra {
  font-size: 28rpx;
  color: var(--muted-2);
}

.help-card {
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.help-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-deep);
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}

.help-line {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.75;
  letter-spacing: 1rpx;
}

.btn-logout {
  background: var(--bg-elevated);
  color: var(--danger);
  font-size: 30rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--line);
  letter-spacing: 1rpx;
}

.btn-logout::after {
  border: none;
}

.error {
  color: var(--danger);
  font-size: 26rpx;
  margin-top: 18rpx;
}

.error.center {
  text-align: center;
}
