.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 120rpx;
  background:
    radial-gradient(ellipse 70% 30% at 0% 0%, rgba(232, 168, 120, 0.22), transparent 60%),
    var(--bg);
  box-sizing: border-box;
}

.profile-card {
  background: linear-gradient(145deg, #fff9f1, #f7e8d8);
  border: 1rpx solid rgba(196, 92, 38, 0.12);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
  box-shadow: var(--shadow);
  margin-bottom: 28rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #f0c9a8, #e07a3a);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.avatar.big {
  width: 140rpx;
  height: 140rpx;
  border-radius: 40rpx;
  font-size: 56rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0 auto 16rpx;
  background: transparent;
  width: 140rpx;
  height: 140rpx;
  border-radius: 40rpx;
  overflow: hidden;
  line-height: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 40rpx;
  display: block;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.name-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 auto 8rpx;
  padding: 8rpx 16rpx;
}

.name-text {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
}

.name-edit-hint {
  font-size: 22rpx;
  color: var(--brand);
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(196, 92, 38, 0.35);
  border-radius: 999rpx;
}

.name-input {
  display: block;
  margin: 0 auto 8rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  width: 80%;
}

.desc {
  display: block;
  margin: 10rpx 0 20rpx;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.5;
}

.stat-row {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}

.stat-item {
  background: rgba(255, 255, 255, 0.65);
  border-radius: 18rpx;
  padding: 16rpx 36rpx;
  min-width: 160rpx;
}

.stat-n {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.1;
}

.stat-l {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.login-btn {
  width: 100%;
  margin-top: 8rpx;
}

.login-form {
  margin: 16rpx 0 8rpx;
  text-align: left;
}

.login-input {
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 20rpx 22rpx;
  font-size: 30rpx;
  margin-bottom: 14rpx;
  color: var(--ink);
}

.login-divider {
  position: relative;
  text-align: center;
  margin: 18rpx 0 12rpx;
}

.login-divider::before {
  content: '';
  position: absolute;
  left: 10%;
  right: 10%;
  top: 50%;
  height: 1rpx;
  background: rgba(196, 92, 38, 0.15);
}

.login-divider-text {
  position: relative;
  background: linear-gradient(145deg, #fff9f1, #f7e8d8);
  padding: 0 14rpx;
  font-size: 22rpx;
  color: var(--muted-2);
}

.login-link {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--brand);
}

.menu {
  overflow: hidden;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid var(--line-soft);
  min-height: var(--tap-min);
  box-sizing: border-box;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-label {
  font-size: 32rpx;
  color: var(--ink);
  font-weight: 500;
}

.menu-extra {
  font-size: 28rpx;
  color: var(--muted-2);
}

.help-card {
  padding: 28rpx;
  margin-bottom: 28rpx;
}

.help-title {
  display: block;
  font-size: 28rpx;
  font-weight: 650;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.help-line {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.7;
}

.btn-logout {
  background: #efe4d4;
  color: #6b3a1a;
  font-size: 30rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e0d2bc;
}

.btn-logout::after {
  border: none;
}

.error {
  color: var(--danger);
  font-size: 26rpx;
  margin-top: 16rpx;
}

.error.center {
  text-align: center;
}
