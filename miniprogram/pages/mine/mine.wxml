<navigation-bar title="我的" back="{{false}}" color="black" background="#F4EFE4"></navigation-bar>

<view class="page">
  <view wx:if="{{!loggedIn}}" class="profile-card">
    <view class="avatar big">微</view>
    <text class="name">未登录</text>
    <text class="desc">登录后可创建回忆录、保存采访记录</text>
    <button class="btn-primary login-btn" loading="{{loggingIn}}" bindtap="onLogin">微信一键登录</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>

  <block wx:else>
    <view class="profile-card">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar big">{{nickInitial}}</view>
      </button>
      <view wx:if="{{!editingNick}}" class="name-display" bindtap="onStartEditNick">
        <text class="name-text">{{nickname || '点击填写昵称'}}</text>
        <text class="name-edit-hint">编辑</text>
      </view>
      <input
        wx:else
        class="name-input"
        placeholder="填写昵称"
        value="{{nickSeed}}"
        maxlength="32"
        focus="{{true}}"
        hold-keyboard="{{true}}"
        adjust-position="{{true}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        bindconfirm="onNicknameBlur"
      />
      <text class="desc">内容仅本人可见 · 家人可代为操作</text>

      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-n">{{memoirCount}}</text>
          <text class="stat-l">本回忆录</text>
        </view>
      </view>
    </view>

    <view class="menu card-surface">
      <view class="menu-item" bindtap="goHome">
        <view class="menu-left">
          <text class="menu-icon">📚</text>
          <text class="menu-label">去整理回忆录</text>
        </view>
        <text class="menu-extra">首页 ›</text>
      </view>
      <view class="menu-item" bindtap="onShowHelp">
        <view class="menu-left">
          <text class="menu-icon">💡</text>
          <text class="menu-label">怎么使用</text>
        </view>
        <text class="menu-extra">›</text>
      </view>
    </view>

    <view class="help-card card-surface">
      <text class="help-title">温馨提示</text>
      <text class="help-line">· 可以慢慢说，答不上来就点「不知道」</text>
      <text class="help-line">· 说得差不多时，可点「生成回忆录」整理成章</text>
      <text class="help-line">· 正文可在首页点「查看正文」阅读</text>
    </view>

    <button class="btn-logout" bindtap="onLogout">退出登录</button>
    <view wx:if="{{error}}" class="error center">{{error}}</view>
  </block>
</view>
