<navigation-bar title="我的" back="{{false}}" color="black" background="#F7F5EE"></navigation-bar>

<view class="page">
  <view wx:if="{{!loggedIn}}" class="profile-card">
    <view class="avatar big">微</view>
    <text class="name">未登录</text>
    <text class="desc">账号密码（未注册自动注册）或微信登录</text>
    <view class="login-form" wx:if="{{!showForgot}}">
      <input
        class="login-input"
        placeholder="账号"
        maxlength="32"
        value="{{accountUser}}"
        bindinput="onAccountUser"
      />
      <input
        class="login-input"
        password
        placeholder="密码（至少 8 位）"
        maxlength="64"
        value="{{accountPass}}"
        bindinput="onAccountPass"
      />
      <button
        class="btn-primary login-btn"
        loading="{{accountLoggingIn}}"
        bindtap="onAccountLogin"
      >账号登录 / 注册</button>
      <text class="login-link" bindtap="onToggleForgot">忘记密码？</text>
    </view>
    <view class="login-form" wx:else>
      <input
        class="login-input"
        placeholder="账号"
        maxlength="32"
        value="{{accountUser}}"
        bindinput="onAccountUser"
      />
      <input
        class="login-input"
        password
        placeholder="恢复密钥（wangshun）"
        maxlength="64"
        value="{{recoveryKey}}"
        bindinput="onRecoveryKey"
      />
      <input
        class="login-input"
        password
        placeholder="新密码（至少 8 位）"
        maxlength="64"
        value="{{newPass}}"
        bindinput="onNewPass"
      />
      <button
        class="btn-primary login-btn"
        loading="{{resetting}}"
        bindtap="onResetPassword"
      >确认重置</button>
      <text class="login-link" bindtap="onToggleForgot">返回登录</text>
    </view>
    <view class="login-divider"><text class="login-divider-text">或</text></view>
    <button class="btn-secondary login-btn" loading="{{loggingIn}}" bindtap="onLogin">微信一键登录</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>

  <block wx:else>
    <view class="profile-card">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar big">{{nickInitial}}</view>
      </button>
      <view wx:if="{{!editingNick}}" class="name-display" bindtap="onStartEditNick">
        <text class="name-text">{{nickname || '点击填写昵称'}}</text>
        <text class="name-edit-hint">编辑</text>
      </view>
      <input
        wx:else
        class="name-input"
        placeholder="填写昵称"
        value="{{nickSeed}}"
        maxlength="32"
        focus="{{true}}"
        hold-keyboard="{{true}}"
        adjust-position="{{true}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        bindconfirm="onNicknameBlur"
      />
      <text class="desc">
        内容仅本人可见
        <text wx:if="{{isAdmin}}"> · 管理员</text>
        <text wx:if="{{username}}"> · {{username}}</text>
      </text>

      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-n">{{memoirCount}}</text>
          <text class="stat-l">本回忆录</text>
        </view>
      </view>
    </view>

    <view class="menu card-surface">
      <view class="menu-item" bindtap="goHome">
        <view class="menu-left">
          <text class="menu-icon">📚</text>
          <text class="menu-label">去整理回忆录</text>
        </view>
        <text class="menu-extra">首页 ›</text>
      </view>
      <view wx:if="{{isAdmin}}" class="menu-item" bindtap="onAdmin">
        <view class="menu-left">
          <text class="menu-icon">🛡️</text>
          <text class="menu-label">管理台</text>
        </view>
        <text class="menu-extra">概览 / 用户 / AI ›</text>
      </view>
      <view class="menu-item" bindtap="onShowHelp">
        <view class="menu-left">
          <text class="menu-icon">💡</text>
          <text class="menu-label">怎么使用</text>
        </view>
        <text class="menu-extra">›</text>
      </view>
    </view>

    <view class="help-card card-surface">
      <text class="help-title">温馨提示</text>
      <text class="help-line">· 可以慢慢说，答不上来就点「不知道」</text>
      <text class="help-line">· 说得差不多时，可点「生成回忆录」整理成章</text>
      <text class="help-line">· 正文可在首页点「查看正文」阅读</text>
    </view>

    <button class="btn-logout" bindtap="onLogout">退出登录</button>
    <view wx:if="{{error}}" class="error center">{{error}}</view>
  </block>
</view>
