/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--muted);
  width: 80%;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 24rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
}

.usermotto {
  margin-top: 200px;
}

.avatar-wrapper {
  padding: 0;
  width: 56px !important;
  border-radius: 8px;
  margin-top: 40px;
  margin-bottom: 40px;
  border: 2rpx solid var(--line);
}

.avatar {
  display: block;
  width: 56px;
  height: 56px;
}

.nickname-wrapper {
  display: flex;
  width: 100%;
  padding: 18rpx;
  box-sizing: border-box;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  color: var(--ink);
}

.nickname-label {
  width: 105px;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.nickname-input {
  flex: 1;
  color: var(--ink);
  letter-spacing: 1rpx;
}
