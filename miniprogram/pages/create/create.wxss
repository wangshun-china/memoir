.page {
  min-height: 100vh;
  padding: 20rpx 32rpx 80rpx;
  background:
    radial-gradient(ellipse 70% 30% at 100% 0%, rgba(232, 168, 120, 0.22), transparent 60%),
    var(--bg);
  box-sizing: border-box;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding: 8rpx 0;
}

.step {
  display: flex;
  align-items: center;
  gap: 10rpx;
  opacity: 0.45;
}

.step.on {
  opacity: 1;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step.on .step-num {
  background: var(--brand);
  color: #fff;
}

.step-label {
  font-size: 24rpx;
  color: var(--muted);
}

.step.on .step-label {
  color: var(--ink);
  font-weight: 600;
}

.step-line {
  width: 48rpx;
  height: 2rpx;
  background: var(--line);
}

.intro {
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.intro-title {
  display: block;
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--ink);
}

.intro-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.55;
}

.form-card {
  padding: 28rpx 28rpx 12rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field.row {
  display: flex;
  gap: 16rpx;
}

.half {
  flex: 1;
  min-width: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  margin-bottom: 12rpx;
  font-weight: 560;
}

.req {
  color: var(--brand);
}

.input {
  background: var(--bg-input);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 24rpx 24rpx;
  font-size: 34rpx;
  color: var(--ink);
  min-height: 48rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--ink);
}

.chip.on {
  background: var(--brand-soft);
  border-color: rgba(196, 92, 38, 0.35);
  color: var(--brand-deep);
  font-weight: 600;
}

.submit {
  margin-top: 28rpx;
  width: 100%;
}

.error {
  margin-top: 18rpx;
  color: var(--danger);
  font-size: 28rpx;
  text-align: center;
}

.tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted-2);
  line-height: 1.5;
}
