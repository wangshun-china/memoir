.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 80rpx;
  background: var(--bg);
  box-sizing: border-box;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 32rpx;
  padding: 10rpx 0;
}

.step {
  display: flex;
  align-items: center;
  gap: 12rpx;
  opacity: 0.4;
}

.step.on {
  opacity: 1;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step.on .step-num {
  background: var(--brand);
  color: var(--bg-elevated);
}

.step-label {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.step.on .step-label {
  color: var(--brand-deep);
  font-weight: 600;
}

.step-line {
  width: 48rpx;
  height: 2rpx;
  background: var(--line);
}

.intro {
  margin-bottom: 28rpx;
  padding: 0 4rpx;
}

.intro-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--brand-deep);
  letter-spacing: 2rpx;
}

.intro-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.form-card {
  padding: 32rpx 32rpx 16rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field.row {
  display: flex;
  gap: 18rpx;
}

.half {
  flex: 1;
  min-width: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  margin-bottom: 14rpx;
  font-weight: 550;
  letter-spacing: 1rpx;
}

.req {
  color: var(--brand);
}

.input {
  background: var(--bg-input);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 26rpx 26rpx;
  font-size: 34rpx;
  color: var(--ink);
  min-height: 48rpx;
  letter-spacing: 1rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.chip {
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.chip.on {
  background: var(--brand-soft);
  border-color: var(--brand);
  color: var(--brand-deep);
  font-weight: 600;
}

.submit {
  margin-top: 32rpx;
  width: 100%;
}

.error {
  margin-top: 20rpx;
  color: var(--danger);
  font-size: 28rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted-2);
  line-height: 1.6;
  letter-spacing: 1rpx;
}
