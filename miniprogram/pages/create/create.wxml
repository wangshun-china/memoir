<navigation-bar title="创建回忆录" back="{{true}}" color="black" background="#F7F5EE"></navigation-bar>

<view class="page">
  <view class="steps">
    <view class="step on">
      <text class="step-num">1</text>
      <text class="step-label">主人信息</text>
    </view>
    <view class="step-line"></view>
    <view class="step">
      <text class="step-num">2</text>
      <text class="step-label">开始采访</text>
    </view>
  </view>

  <view class="intro">
    <text class="intro-title">先记下主人是谁</text>
    <text class="intro-desc">只需最少信息。其余细节可以在采访里慢慢补充。</text>
  </view>

  <view class="form-card card-surface">
    <view class="field">
      <text class="label">回忆录主人姓名 <text class="req">*</text></text>
      <input
        class="input"
        placeholder="例如：王大爷"
        maxlength="40"
        hold-keyboard="{{true}}"
        adjust-position="{{true}}"
        bindinput="onSubject"
      />
    </view>

    <view class="field">
      <text class="label">希望系统如何称呼</text>
      <input
        class="input"
        placeholder="例如：王大爷 / 父亲"
        maxlength="40"
        hold-keyboard="{{true}}"
        adjust-position="{{true}}"
        bindinput="onPreferred"
      />
    </view>

    <view class="field row">
      <view class="half">
        <text class="label">出生年份</text>
        <input
          class="input"
          type="number"
          placeholder="1948"
          maxlength="4"
          hold-keyboard="{{true}}"
          adjust-position="{{true}}"
          bindinput="onBirthYear"
        />
      </view>
      <view class="half">
        <text class="label">出生地</text>
        <input
          class="input"
          placeholder="河北某县"
          maxlength="40"
          hold-keyboard="{{true}}"
          adjust-position="{{true}}"
          bindinput="onBirthPlace"
        />
      </view>
    </view>

    <view class="field">
      <text class="label">您与主人的关系</text>
      <view class="chips">
        <view
          class="chip {{relationChip === '本人' ? 'on' : ''}}"
          data-v="本人"
          bindtap="onRelationChip"
        >本人</view>
        <view
          class="chip {{relationChip === '儿子' ? 'on' : ''}}"
          data-v="儿子"
          bindtap="onRelationChip"
        >儿子</view>
        <view
          class="chip {{relationChip === '女儿' ? 'on' : ''}}"
          data-v="女儿"
          bindtap="onRelationChip"
        >女儿</view>
        <view
          class="chip {{relationChip === '其他' ? 'on' : ''}}"
          data-v="其他"
          bindtap="onRelationChip"
        >其他</view>
      </view>
      <input
        wx:if="{{relationChip === '其他' || !relationChip}}"
        class="input"
        placeholder="可填写：儿媳 / 孙子…"
        maxlength="20"
        hold-keyboard="{{true}}"
        adjust-position="{{true}}"
        bindinput="onRelation"
      />
    </view>
  </view>

  <button class="btn-primary submit" loading="{{submitting}}" bindtap="onSubmit">创建并开始采访</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="tip">创建后会准备 9 个章节，先从「童年与家庭」聊起。</view>
</view>
