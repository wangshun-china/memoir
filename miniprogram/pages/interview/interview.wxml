<navigation-bar title="文字采访" back="{{true}}" color="black" background="#F4EFE4"></navigation-bar>

<view class="page">
  <view class="topic-bar">
    <view class="topic-row">
      <view class="topic-chip">{{resumed ? '继续上次' : '正在整理'}}</view>
      <text class="save-pill">{{saveHint}}</text>
    </view>
    <text class="topic-main">{{topic}}</text>
    <text class="topic-sub">{{topicHint}} · 已对话 {{userTurnCount}} 轮</text>
  </view>

  <scroll-view
    scroll-y
    class="messages"
    scroll-into-view="{{scrollInto}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="m-{{item.id}}"
      class="row {{item.role === 'user' ? 'row-user' : 'row-ai'}}"
    >
      <view class="avatar-sm {{item.role === 'user' ? 'me' : 'ai'}}">{{item.role === 'user' ? '我' : '采'}}</view>
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
        <text class="bubble-role" wx:if="{{item.role !== 'user'}}">采访者</text>
        <text class="bubble-text">{{item.content}}</text>
      </view>
    </view>
    <view class="messages-spacer"></view>
  </scroll-view>

  <view class="composer safe-bottom">
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{waitHint}}" class="wait-hint">{{waitHint}}</view>
    <view
      wx:if="{{generatedPreview || generationStatus === 'generating' || generationStatus === 'ready'}}"
      class="gen-banner"
      bindtap="onViewGenerated"
    >
      <text class="gen-banner-text" wx:if="{{generationStatus === 'generating'}}">章节正在后台生成… 完成后可点此查看</text>
      <text class="gen-banner-text" wx:else>✓ 章节草稿已保存，点此查看</text>
    </view>

    <view class="compose-row" wx:if="{{!finished}}">
      <textarea
        wx:if="{{composerAlive}}"
        id="composer-{{composerKey}}"
        class="input"
        placeholder="慢慢说，想到什么写什么…"
        maxlength="2000"
        bindinput="onDraft"
        auto-height
        show-confirm-bar="{{false}}"
        hold-keyboard="{{true}}"
        adjust-position="{{true}}"
        disable-default-padding="{{true}}"
        confirm-type="send"
        bindconfirm="onSend"
      />
      <button
        class="btn-send-inline"
        loading="{{sending}}"
        disabled="{{sending}}"
        bindtap="onSend"
      >发送</button>
    </view>
    <view wx:else class="input-done">本次采访已结束，记录已保存。</view>

    <view class="tool-row" wx:if="{{!finished}}">
      <button class="tool-btn" size="mini" disabled="{{sending}}" data-action="dont_know" bindtap="onAction">不知道</button>
      <button class="tool-btn" size="mini" disabled="{{sending}}" data-action="change_question" bindtap="onAction">换一题</button>
      <button class="tool-btn more" size="mini" disabled="{{sending}}" bindtap="onMoreTools">更多</button>
    </view>
  </view>
</view>
