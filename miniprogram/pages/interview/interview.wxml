<navigation-bar title="文字采访" back="{{true}}" color="black" background="#F4EFE4"></navigation-bar>

<view class="page">
  <view class="topic-bar">
    <view class="topic-row">
      <view class="topic-chip">{{resumed ? '继续上次' : '正在整理'}}</view>
      <text class="save-pill">{{saveHint}}</text>
    </view>
    <text class="topic-main">{{topic}}</text>
    <text class="topic-sub">已对话 {{userTurnCount}} 轮 · 满 {{autoGenerateAt}} 轮自动生成章节</text>
  </view>

  <scroll-view
    scroll-y
    class="messages"
    scroll-into-view="{{scrollInto}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="m-{{item.id}}"
      class="row {{item.role === 'user' ? 'row-user' : 'row-ai'}}"
    >
      <view class="avatar-sm {{item.role === 'user' ? 'me' : 'ai'}}">{{item.role === 'user' ? '我' : '采'}}</view>
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
        <text class="bubble-text">{{item.content}}</text>
      </view>
    </view>
    <view class="messages-spacer"></view>
  </scroll-view>

  <!-- 底部固定：输入 + 发送始终可见，无需上滑找按钮 -->
  <view class="composer safe-bottom">
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{generatedPreview}}" class="gen-banner" bindtap="onViewGenerated">
      <text class="gen-banner-text">✓ 章节草稿已保存，点此查看</text>
    </view>

    <view class="compose-row" wx:if="{{!finished}}">
      <!-- composerAlive + composerKey: unmount/remount after send so native text is wiped -->
      <textarea
        wx:if="{{composerAlive}}"
        id="composer-{{composerKey}}"
        class="input"
        placeholder="慢慢说，想到什么写什么…"
        maxlength="2000"
        bindinput="onDraft"
        auto-height
        show-confirm-bar="{{false}}"
        hold-keyboard="{{true}}"
        adjust-position="{{true}}"
        disable-default-padding="{{true}}"
        confirm-type="send"
        bindconfirm="onSend"
      />
      <button
        class="btn-send-inline"
        loading="{{sending}}"
        disabled="{{sending}}"
        bindtap="onSend"
      >发送</button>
    </view>
    <view wx:else class="input-done">本次采访已结束，对话已保存在云端。</view>

    <!-- 生成与结束单独一行，不和「不知道/换题」混在一起 -->
    <view class="gen-row">
      <button
        class="btn-gen-main"
        loading="{{generating}}"
        disabled="{{sending || generating || userTurnCount < 1}}"
        bindtap="onGenerate"
      >生成回忆录</button>
      <button
        class="btn-end-main"
        disabled="{{finished || sending}}"
        data-action="end"
        bindtap="onAction"
      >结束采访</button>
    </view>

    <scroll-view scroll-x class="actions-scroll" enhanced show-scrollbar="{{false}}">
      <view class="actions">
        <button class="action" size="mini" disabled="{{finished || sending}}" data-action="dont_know" bindtap="onAction">不知道</button>
        <button class="action" size="mini" disabled="{{finished || sending}}" data-action="change_question" bindtap="onAction">换一题</button>
        <button class="action" size="mini" disabled="{{finished || sending}}" data-action="prefer_not" bindtap="onAction">不想说</button>
      </view>
    </scroll-view>
  </view>
</view>
