.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4efe4;
  box-sizing: border-box;
  overflow: hidden;
}

.topic-bar {
  flex-shrink: 0;
  padding: 16rpx 28rpx 14rpx;
  background: linear-gradient(180deg, #f7e8d8, #f0e4d2);
  border-bottom: 1rpx solid #e6d9c4;
}

.topic-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.topic-chip {
  display: inline-block;
  font-size: 20rpx;
  color: #9a3f14;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.save-pill {
  font-size: 20rpx;
  color: #3d6b3a;
  background: rgba(232, 239, 223, 0.95);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.topic-main {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2a2318;
}

.topic-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6f634f;
}

.messages {
  flex: 1;
  height: 0;
  padding: 20rpx 22rpx 0;
  box-sizing: border-box;
}

.messages-spacer {
  height: 24rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.row-user {
  flex-direction: row-reverse;
}

.avatar-sm {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-sm.ai {
  background: #efe4d4;
  color: #6f634f;
}

.avatar-sm.me {
  background: linear-gradient(145deg, #e8a878, #c45c26);
  color: #fff;
}

.bubble {
  max-width: 78%;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(68, 42, 18, 0.05);
}

.bubble-ai {
  background: #fffdf8;
  border: 1rpx solid #e6d9c4;
  border-top-left-radius: 8rpx;
}

.bubble-user {
  background: linear-gradient(145deg, #f0c9a8, #e8b48a);
  border-top-right-radius: 8rpx;
}

.bubble-text {
  font-size: 30rpx;
  line-height: 1.55;
  color: #2a2318;
  white-space: pre-wrap;
}

.composer {
  flex-shrink: 0;
  padding: 12rpx 20rpx 12rpx;
  background: #fffdf8;
  border-top: 1rpx solid #e6d9c4;
  box-shadow: 0 -8rpx 24rpx rgba(68, 42, 18, 0.06);
}

.safe-bottom {
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.compose-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.input {
  flex: 1;
  min-height: 72rpx;
  max-height: 200rpx;
  background: #f7f1e7;
  border: 1rpx solid #e6d9c4;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  color: #2a2318;
}

.btn-send-inline {
  flex-shrink: 0;
  width: 140rpx !important;
  margin: 0 !important;
  padding: 0 12rpx !important;
  height: 72rpx;
  line-height: 72rpx !important;
  font-size: 28rpx !important;
  font-weight: 600;
  color: #fff !important;
  background: linear-gradient(135deg, #d86a2f 0%, #c45c26 55%, #a84716 100%) !important;
  border-radius: 16rpx !important;
  box-shadow: 0 8rpx 18rpx rgba(196, 92, 38, 0.28);
}

.btn-send-inline::after {
  border: none;
}

.btn-send-inline[disabled] {
  opacity: 0.55;
}

.input-done {
  min-height: 72rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #6f634f;
  background: #f7f1e7;
  border-radius: 14rpx;
}

.gen-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.btn-gen-main {
  flex: 1.4;
  margin: 0 !important;
  height: 72rpx;
  line-height: 72rpx !important;
  font-size: 28rpx !important;
  font-weight: 600;
  color: #9a3f14 !important;
  background: #f3d7c4 !important;
  border-radius: 16rpx !important;
  border: 1rpx solid #e8b48a !important;
}

.btn-gen-main::after {
  border: none;
}

.btn-end-main {
  flex: 1;
  margin: 0 !important;
  height: 72rpx;
  line-height: 72rpx !important;
  font-size: 26rpx !important;
  color: #6b3a1a !important;
  background: #efe4d4 !important;
  border-radius: 16rpx !important;
  border: 1rpx solid #e0d2bc !important;
}

.btn-end-main::after {
  border: none;
}

.actions-scroll {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.actions {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  padding-right: 8rpx;
}

.action {
  display: inline-block;
  background: #efe4d4 !important;
  color: #2a2318 !important;
  font-size: 22rpx !important;
  border-radius: 999rpx !important;
  border: 1rpx solid #e0d2bc !important;
  line-height: 1.4 !important;
  padding: 0 18rpx !important;
  margin: 0 !important;
  flex-shrink: 0;
}

.action::after {
  border: none;
}

.action-gen {
  background: #f3d7c4 !important;
  color: #9a3f14 !important;
  border-color: #e8b48a !important;
  font-weight: 600 !important;
}

.action-end {
  background: #e8d9c8 !important;
  color: #6b3a1a !important;
}

.wait-hint {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #8a7b66;
  background: #f7f1e7;
  border-radius: 12rpx;
  padding: 10rpx 14rpx;
}

.gen-banner {
  margin-bottom: 10rpx;
  background: #e8efdf;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.gen-banner-text {
  font-size: 26rpx;
  color: #3d6b3a;
}

.error {
  margin-bottom: 8rpx;
  color: #a33;
  font-size: 24rpx;
}
