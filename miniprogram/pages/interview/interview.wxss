.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  box-sizing: border-box;
  overflow: hidden;
}

.topic-bar {
  flex-shrink: 0;
  padding: 16rpx 28rpx 14rpx;
  background: linear-gradient(180deg, #f7e8d8, #f0e4d2);
  border-bottom: 1rpx solid var(--line);
}

.topic-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.topic-chip {
  display: inline-block;
  font-size: 20rpx;
  color: var(--brand-deep);
  background: rgba(255, 255, 255, 0.75);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.save-pill {
  font-size: 20rpx;
  color: var(--success);
  background: rgba(232, 239, 223, 0.95);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.topic-main {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.topic-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.messages {
  flex: 1;
  height: 0;
  padding: 20rpx 22rpx 0;
  box-sizing: border-box;
}

.messages-spacer {
  height: 24rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.row-user {
  flex-direction: row-reverse;
}

.avatar-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-sm.ai {
  background: #efe4d4;
  color: var(--muted);
}

.avatar-sm.me {
  background: linear-gradient(145deg, #e8a878, var(--brand));
  color: #fff;
}

.bubble {
  max-width: 78%;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(68, 42, 18, 0.05);
}

.bubble-ai {
  background: var(--bg-elevated);
  border: 1rpx solid var(--line);
  border-top-left-radius: 8rpx;
}

.bubble-user {
  background: linear-gradient(145deg, #f0c9a8, #e8b48a);
  border-top-right-radius: 8rpx;
}

.bubble-role {
  display: block;
  font-size: 20rpx;
  color: var(--muted-2);
  margin-bottom: 6rpx;
}

.bubble-text {
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--ink);
  white-space: pre-wrap;
}

.composer {
  flex-shrink: 0;
  padding: 12rpx 20rpx 12rpx;
  background: var(--bg-elevated);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -8rpx 24rpx rgba(68, 42, 18, 0.06);
}

.safe-bottom {
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.compose-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.input {
  flex: 1;
  min-height: 80rpx;
  max-height: 200rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 16rpx 18rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  color: var(--ink);
}

.btn-send-inline {
  flex-shrink: 0;
  width: 148rpx !important;
  margin: 0 !important;
  padding: 0 12rpx !important;
  height: 80rpx;
  line-height: 80rpx !important;
  font-size: 30rpx !important;
  font-weight: 600;
  color: #fff !important;
  background: linear-gradient(135deg, #d86a2f 0%, #c45c26 55%, #a84716 100%) !important;
  border-radius: 16rpx !important;
  box-shadow: 0 8rpx 18rpx var(--brand-glow);
}

.btn-send-inline::after {
  border: none;
}

.btn-send-inline[disabled] {
  opacity: 0.55;
}

.input-done {
  min-height: 72rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--bg-input);
  border-radius: 14rpx;
}

.tool-row {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.tool-btn {
  margin: 0 !important;
  background: #efe4d4 !important;
  color: var(--ink) !important;
  font-size: 24rpx !important;
  border-radius: 999rpx !important;
  border: 1rpx solid #e0d2bc !important;
  line-height: 1.4 !important;
  padding: 0 22rpx !important;
  min-height: 56rpx;
}

.tool-btn.more {
  background: var(--brand-soft) !important;
  color: var(--brand-deep) !important;
  border-color: rgba(196, 92, 38, 0.3) !important;
  font-weight: 600 !important;
}

.tool-btn::after {
  border: none;
}

.wait-hint {
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  background: var(--bg-input);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.gen-banner {
  margin-bottom: 10rpx;
  background: var(--success-bg);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}

.gen-banner-text {
  font-size: 26rpx;
  color: var(--success);
  line-height: 1.45;
}

.error {
  margin-bottom: 8rpx;
  color: var(--danger);
  font-size: 24rpx;
}
