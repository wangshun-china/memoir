<navigation-bar title="回忆录" back="{{false}}" color="black" background="#F4EFE4"></navigation-bar>

<view class="page">
  <view class="hero-card">
    <view class="hero-badge">人生故事 · 慢慢说</view>
    <text class="hero-title">把零散回忆，收成一本家书</text>
    <text class="hero-sub">温和采访 · 自动成章 · 留给家人珍藏</text>
    <view class="hero-stats" wx:if="{{loggedIn}}">
      <view class="stat-pill">
        <text class="stat-num">{{memoirs.length}}</text>
        <text class="stat-label">本回忆录</text>
      </view>
      <view class="stat-pill soft">
        <text class="stat-label">一点一点说，不着急。随时可以停下来。</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!loggedIn}}" class="login-card card-surface">
    <view class="login-icon">📖</view>
    <text class="login-title">登录后开始整理回忆</text>
    <text class="login-desc">可用账号密码（未注册将自动注册），或微信一键登录。</text>

    <view class="login-form" wx:if="{{!showForgot}}">
      <input
        class="login-input"
        placeholder="账号（3—32 位字母数字）"
        maxlength="32"
        value="{{accountUser}}"
        bindinput="onAccountUser"
      />
      <input
        class="login-input"
        password
        placeholder="密码（至少 8 位）"
        maxlength="64"
        value="{{accountPass}}"
        bindinput="onAccountPass"
      />
      <button
        class="btn-primary login-btn"
        loading="{{accountLoggingIn}}"
        bindtap="onAccountLogin"
      >账号登录 / 注册</button>
      <text class="login-link" bindtap="onToggleForgot">忘记密码？</text>
      <text class="login-hint">没有账号会自动注册；账号 wangshun 为管理员（体验版）</text>
    </view>

    <view class="login-form" wx:else>
      <text class="login-title-sm">重置密码</text>
      <input
        class="login-input"
        placeholder="账号"
        maxlength="32"
        value="{{accountUser}}"
        bindinput="onAccountUser"
      />
      <input
        class="login-input"
        password
        placeholder="恢复密钥"
        maxlength="64"
        value="{{recoveryKey}}"
        bindinput="onRecoveryKey"
      />
      <input
        class="login-input"
        password
        placeholder="新密码（至少 8 位）"
        maxlength="64"
        value="{{newPass}}"
        bindinput="onNewPass"
      />
      <button
        class="btn-primary login-btn"
        loading="{{resetting}}"
        bindtap="onResetPassword"
      >确认重置</button>
      <text class="login-link" bindtap="onToggleForgot">返回登录</text>
      <text class="login-hint">体验版恢复密钥为 wangshun</text>
    </view>

    <view class="login-divider"><text class="login-divider-text">或</text></view>
    <button class="btn-secondary login-btn" loading="{{loggingIn}}" bindtap="onLogin">微信一键登录</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>

  <block wx:else>
    <view class="toolbar">
      <button class="btn-primary create-btn" bindtap="onCreate">＋ 创建一本回忆录</button>
    </view>

    <view wx:if="{{loading}}" class="state-box card-surface">
      <view class="spinner"></view>
      <text class="muted">正在加载…</text>
    </view>
    <view wx:elif="{{error}}" class="state-box card-surface error-box">
      <text class="error">{{error}}</text>
      <button class="btn-secondary" bindtap="load">重试</button>
    </view>

    <view wx:elif="{{memoirs.length === 0}}" class="empty-card card-surface">
      <view class="empty-icon">📔</view>
      <text class="empty-title">还没有回忆录</text>
      <text class="empty-desc">创建后会准备 9 个章节。采访者会一问一答陪您慢慢讲。</text>
      <button class="btn-primary empty-btn" bindtap="onCreate">现在创建</button>
    </view>

    <view class="list" wx:else>
      <view class="section-title">我的回忆录</view>
      <view class="card" wx:for="{{memoirs}}" wx:key="id">
        <view class="card-top" data-id="{{item.id}}" bindtap="onOpenReader">
          <view class="avatar">{{item.subject_name[0] || '忆'}}</view>
          <view class="card-head">
            <text class="card-title">{{item.title}}</text>
            <text class="card-meta">主人 · {{item.subject_name}}</text>
          </view>
          <text class="card-more" catchtap="onCardMore" data-id="{{item.id}}" data-title="{{item.title}}">···</text>
        </view>

        <view class="status-row">
          <text class="tag {{item.status_tone === 'active' ? 'soft' : ''}}">{{item.status_text}}</text>
          <text class="link-text" data-id="{{item.id}}" catchtap="onOpenReader">查看正文 ›</text>
        </view>

        <view class="progress-track" wx:if="{{item.has_interview}}">
          <view class="progress-fill" style="width: {{item.progress_pct}}%;"></view>
        </view>
        <text class="progress-hint" wx:if="{{item.has_interview}}">对话越丰富，整理出的章节越生动</text>

        <!-- 唯一主操作：开始 / 继续 -->
        <button
          wx:if="{{!item.has_interview}}"
          class="btn-primary card-cta"
          catchtap="onStartInterview"
          data-id="{{item.id}}"
        >{{item.primary_label}}</button>
        <button
          wx:else
          class="btn-primary card-cta"
          catchtap="onContinueInterview"
          data-id="{{item.id}}"
          data-session-id="{{item.continue_session_id}}"
          data-topic="{{item.continue_topic || '童年与家庭'}}"
        >{{item.primary_label}}</button>
      </view>
    </view>
  </block>
</view>
