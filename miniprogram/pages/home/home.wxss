.page {
  min-height: 100vh;
  padding: 32rpx 36rpx 80rpx;
  background: #f7f3ea;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 36rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #2c2416;
  line-height: 1.4;
}

.hero-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6b5e48;
}

.toolbar {
  margin-bottom: 28rpx;
}

.btn-primary {
  background: #c45c26;
  color: #fff;
  font-size: 34rpx;
  border-radius: 16rpx;
  padding: 12rpx 0;
}

.btn-secondary {
  background: #efe6d6;
  color: #2c2416;
  font-size: 28rpx;
}

.muted,
.empty {
  font-size: 30rpx;
  color: #6b5e48;
  line-height: 1.6;
}

.error {
  color: #a33;
  font-size: 30rpx;
}

.card {
  background: #fffdf8;
  border: 1rpx solid #e5d9c4;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #2c2416;
}

.card-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #6b5e48;
}

.card-actions {
  margin-top: 20rpx;
}
