.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 120rpx;
  background: var(--bg);
  box-sizing: border-box;
}

.hero-card {
  background: linear-gradient(170deg, var(--bg-elevated) 0%, #F0EDE3 100%);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  padding: 48rpx 36rpx 40rpx;
  box-shadow: var(--shadow);
  margin-bottom: 36rpx;
  position: relative;
  overflow: hidden;
}

.hero-card::before {
  content: '';
  position: absolute;
  left: -30rpx;
  bottom: -30rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(45, 90, 61, 0.04) 0%, transparent 70%);
}

.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin-bottom: 20rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: var(--brand-deep);
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.hero-sub {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.hero-stats {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  flex-wrap: wrap;
}

.stat-pill {
  background: var(--bg-elevated);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
  min-width: 140rpx;
}

.stat-pill.soft {
  flex: 1;
  min-width: 220rpx;
}

.stat-num {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.1;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
  line-height: 1.5;
}

.toolbar {
  margin-bottom: 28rpx;
}

.create-btn {
  width: 100%;
}

.profile-setup {
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 28rpx;
}

.setup-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand-deep);
  letter-spacing: 2rpx;
}

.setup-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.setup-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 28rpx;
}

.setup-avatar-btn {
  padding: 0;
  margin: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  line-height: 0;
  background: var(--bg-input);
  border: 2rpx solid var(--line);
  flex-shrink: 0;
}

.setup-avatar-btn::after {
  border: none;
}

.setup-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: block;
}

.setup-avatar-ph {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
}

.setup-nickname {
  flex: 1;
  min-width: 0;
  background: var(--bg-input);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
  font-size: 32rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.setup-save {
  margin-top: 28rpx;
  width: 100%;
}

.setup-skip {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted-2);
  letter-spacing: 1rpx;
}

.section-title {
  font-size: 28rpx;
  color: var(--muted);
  margin: 12rpx 4rpx 20rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.card {
  background: var(--bg-elevated);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.card-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.card-head {
  flex: 1;
  min-width: 0;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 650;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.card-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.card-more {
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--muted-2);
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  gap: 16rpx;
}

.tag {
  font-size: 24rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  letter-spacing: 1rpx;
}

.tag.soft {
  color: var(--success);
  background: var(--success-bg);
}

.link-text {
  font-size: 26rpx;
  color: var(--brand);
  padding: 8rpx 0;
  letter-spacing: 1rpx;
}

.progress-track {
  margin-top: 20rpx;
  height: 6rpx;
  background: var(--bg-input);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brand-soft), var(--brand));
  border-radius: 999rpx;
  min-width: 4%;
  transition: width 0.25s ease;
}

.progress-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted-2);
  letter-spacing: 1rpx;
}

.card-cta {
  margin-top: 24rpx !important;
  width: 100%;
}

.state-box,
.empty-card {
  background: var(--bg-elevated);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 56rpx 36rpx;
  text-align: center;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--line);
  border-top-color: var(--brand);
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.muted {
  font-size: 28rpx;
  color: var(--muted);
}

.error-box .error {
  display: block;
  color: var(--danger);
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: 650;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.empty-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.empty-btn {
  margin-top: 36rpx;
  width: 75%;
}

.login-card {
  padding: 56rpx 36rpx;
  text-align: center;
}

.login-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.login-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand-deep);
  letter-spacing: 2rpx;
}

.login-desc {
  display: block;
  margin: 16rpx 0 36rpx;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.login-btn {
  width: 100%;
  margin-top: 0;
}

.login-form {
  margin: 8rpx 0 20rpx;
  text-align: left;
}

.login-input {
  background: var(--bg-input);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 24rpx 26rpx;
  font-size: 32rpx;
  color: var(--ink);
  margin-bottom: 18rpx;
  letter-spacing: 1rpx;
}

.login-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--muted-2);
  line-height: 1.5;
  text-align: center;
  letter-spacing: 1rpx;
}

.login-link {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--brand);
  letter-spacing: 1rpx;
}

.login-title-sm {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
  text-align: center;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.login-divider {
  position: relative;
  text-align: center;
  margin: 24rpx 0 18rpx;
}

.login-divider::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 1rpx;
  background: var(--line);
}

.login-divider-text {
  position: relative;
  background: var(--bg-elevated);
  padding: 0 18rpx;
  font-size: 24rpx;
  color: var(--muted-2);
  letter-spacing: 1rpx;
}

.login-card .error {
  display: block;
  margin-top: 18rpx;
  color: var(--danger);
  font-size: 26rpx;
}
