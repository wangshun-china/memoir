.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 120rpx;
  background:
    radial-gradient(ellipse 80% 40% at 0% 0%, rgba(232, 168, 120, 0.28), transparent 60%),
    radial-gradient(ellipse 70% 35% at 100% 10%, rgba(196, 168, 120, 0.18), transparent 55%),
    var(--bg);
  box-sizing: border-box;
}

.hero-card {
  background: linear-gradient(145deg, #fff9f1 0%, #f7e8d8 48%, #f0d7c0 100%);
  border: 1rpx solid rgba(196, 92, 38, 0.12);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx 32rpx;
  box-shadow: var(--shadow);
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
}

.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--brand-deep);
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(196, 92, 38, 0.15);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.35;
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.55;
}

.hero-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  flex-wrap: wrap;
}

.stat-pill {
  background: rgba(255, 255, 255, 0.78);
  border-radius: 18rpx;
  padding: 14rpx 20rpx;
  min-width: 120rpx;
}

.stat-pill.soft {
  flex: 1;
  min-width: 200rpx;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.1;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
  line-height: 1.45;
}

.toolbar {
  margin-bottom: 24rpx;
}

.create-btn {
  width: 100%;
}

.section-title {
  font-size: 28rpx;
  color: var(--muted);
  margin: 8rpx 4rpx 18rpx;
  font-weight: 600;
}

.card {
  background: var(--bg-elevated);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.card-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #f0c9a8, #e07a3a);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-head {
  flex: 1;
  min-width: 0;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 650;
  color: var(--ink);
}

.card-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.card-more {
  width: 64rpx;
  height: 64rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--muted-2);
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 16rpx;
}

.tag {
  font-size: 24rpx;
  color: var(--brand-deep);
  background: #f7e4d4;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

.tag.soft {
  color: #5a6b4a;
  background: var(--success-bg);
}

.link-text {
  font-size: 26rpx;
  color: var(--brand);
  padding: 8rpx 0;
}

.progress-track {
  margin-top: 16rpx;
  height: 10rpx;
  background: #efe4d4;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #e8a878, var(--brand));
  border-radius: 999rpx;
  min-width: 4%;
  transition: width 0.25s ease;
}

.progress-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted-2);
}

.card-cta {
  margin-top: 22rpx !important;
  width: 100%;
}

.state-box,
.empty-card {
  background: var(--bg-elevated);
  border: 1rpx dashed #e0d2bc;
  border-radius: var(--radius);
  padding: 48rpx 36rpx;
  text-align: center;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--line);
  border-top-color: var(--brand);
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.muted {
  font-size: 28rpx;
  color: var(--muted);
}

.error-box .error {
  display: block;
  color: var(--danger);
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: 650;
  color: var(--ink);
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.65;
}

.empty-btn {
  margin-top: 32rpx;
  width: 75%;
}

.login-card {
  padding: 48rpx 36rpx;
  text-align: center;
}

.login-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.login-title {
  display: block;
  font-size: 36rpx;
  font-weight: 650;
  color: var(--ink);
}

.login-desc {
  display: block;
  margin: 14rpx 0 32rpx;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.6;
}

.login-btn {
  width: 100%;
}

.login-card .error {
  display: block;
  margin-top: 16rpx;
  color: var(--danger);
  font-size: 26rpx;
}
