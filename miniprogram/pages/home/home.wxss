.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 100rpx;
  background:
    radial-gradient(ellipse 80% 40% at 0% 0%, rgba(232, 168, 120, 0.28), transparent 60%),
    radial-gradient(ellipse 70% 35% at 100% 10%, rgba(196, 168, 120, 0.18), transparent 55%),
    #f4efe4;
  box-sizing: border-box;
}

.hero-card {
  background: linear-gradient(145deg, #fff9f1 0%, #f7e8d8 48%, #f0d7c0 100%);
  border: 1rpx solid rgba(196, 92, 38, 0.12);
  border-radius: 28rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow: var(--shadow);
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
}

.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #9a3f14;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(196, 92, 38, 0.15);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #2a2318;
  line-height: 1.35;
  letter-spacing: 0.5rpx;
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #6f634f;
  line-height: 1.55;
}

.hero-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  flex-wrap: wrap;
}

.stat-pill {
  background: rgba(255, 255, 255, 0.75);
  border-radius: 18rpx;
  padding: 14rpx 20rpx;
  min-width: 120rpx;
}

.stat-pill.soft {
  flex: 1;
  min-width: 200rpx;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #c45c26;
  line-height: 1.1;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #6f634f;
  margin-top: 4rpx;
}

.toolbar {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 28rpx;
  color: #6f634f;
  margin: 8rpx 4rpx 18rpx;
  font-weight: 600;
}

.card {
  background: #fffdf8;
  border: 1rpx solid #e6d9c4;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(68, 42, 18, 0.06);
}

.card-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #f0c9a8, #e07a3a);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-head {
  flex: 1;
  min-width: 0;
}

.card-title {
  display: block;
  font-size: 34rpx;
  font-weight: 650;
  color: #2a2318;
}

.card-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #6f634f;
}

.chevron {
  font-size: 40rpx;
  color: #c4b6a0;
  line-height: 1;
}

.card-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #9a3f14;
  background: #f7e4d4;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.tag.soft {
  color: #5a6b4a;
  background: #e8efdf;
}

.card-actions {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.start-btn {
  font-size: 26rpx !important;
  padding: 0 22rpx !important;
  margin: 0 !important;
}

.btn-danger-mini {
  background: #f8e8e6 !important;
  color: #a33 !important;
  border: 1rpx solid rgba(170, 51, 51, 0.35) !important;
}

.btn-danger-mini::after {
  border: none;
}

.state-box,
.empty-card {
  background: #fffdf8;
  border: 1rpx dashed #e0d2bc;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e6d9c4;
  border-top-color: #c45c26;
  border-radius: 50%;
  margin: 0 auto 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.muted {
  font-size: 28rpx;
  color: #6f634f;
}

.error-box .error {
  display: block;
  color: #a33;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 650;
  color: #2a2318;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6f634f;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 28rpx;
  width: 70%;
}

.login-card {
  background: #fffdf8;
  border: 1rpx solid #e6d9c4;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(68, 42, 18, 0.06);
  text-align: center;
}

.login-title {
  display: block;
  font-size: 34rpx;
  font-weight: 650;
  color: #2a2318;
}

.login-desc {
  display: block;
  margin: 12rpx 0 28rpx;
  font-size: 28rpx;
  color: #6f634f;
  line-height: 1.55;
}

.login-card .error {
  display: block;
  margin-top: 16rpx;
  color: #a33;
  font-size: 26rpx;
}
