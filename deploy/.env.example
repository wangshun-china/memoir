# Runtime secrets are generated by GitHub Actions on the server.

MEMOIR_PG_USER=memoir
MEMOIR_PG_PASSWORD=replace-with-strong-password
MEMOIR_PG_DB=memoir
MEMOIR_API_BIND_HOST=172.17.0.1
MEMOIR_API_HOST_PORT=18080

JWT_SECRET=replace-with-long-random-jwt-secret
# 管理员账号在首次打开 /admin/ 时创建，密码 Argon2 存库
# 忘记密码时在管理台输入此「恢复密钥」重置（勿与登录密码相同）
ADMIN_RECOVERY_SECRET=replace-with-long-recovery-secret
RUST_LOG=info

LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 1 = 开启模型思考/推理（回答更稳，稍慢，前端可见思考过程）；0 = 追求最快回复
LLM_ENABLE_THINKING=1

# 小程序真实登录（必填才能微信登录；勿提交仓库）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 仅 CI/本地 API 单测，生产保持 0 或不设置
ALLOW_DEV_LOGIN=0
