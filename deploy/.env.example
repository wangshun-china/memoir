# Runtime secrets are generated by GitHub Actions on the server.

MEMOIR_PG_USER=memoir
MEMOIR_PG_PASSWORD=replace-with-strong-password
MEMOIR_PG_DB=memoir
MEMOIR_API_BIND_HOST=172.17.0.1
MEMOIR_API_HOST_PORT=18080

JWT_SECRET=replace-with-long-random-jwt-secret
# 管理员账号在首次打开 /admin/ 时创建，存入数据库，不再使用环境变量密码
RUST_LOG=info

LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 小程序真实登录（必填才能微信登录；勿提交仓库）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 仅 CI/本地 API 单测，生产保持 0 或不设置
ALLOW_DEV_LOGIN=0
