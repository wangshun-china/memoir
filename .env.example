# Copy to .env (gitignored) for local overrides or production secrets.

# --- Database (always via Docker; never install Postgres on the host OS) ---
MEMOIR_PG_USER=memoir
MEMOIR_PG_PASSWORD=change-me
MEMOIR_PG_DB=memoir
MEMOIR_PG_PORT=5433
DATABASE_URL=postgres://memoir:change-me@127.0.0.1:5433/memoir

# --- API ---
LISTEN_ADDR=0.0.0.0:8080
JWT_SECRET=change-me-long-random-string
RUST_LOG=info

# --- Optional WeChat / LLM ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Production host (do not commit real passwords) ---
# REMOTE_SSH_HOST=120.26.186.0
# REMOTE_SSH_USER=root
# MEMOIR_API_HOST_PORT=18080
