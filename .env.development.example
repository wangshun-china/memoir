# Copy to .env.development. This file is for local development only.

MEMOIR_PG_USER=memoir
MEMOIR_PG_PASSWORD=memoir
MEMOIR_PG_DB=memoir
MEMOIR_PG_PORT=5433
MEMOIR_API_PORT=18081

JWT_SECRET=dev-only-change-me-jwt-secret
RUST_LOG=info

# These may instead come from Windows machine-level environment variables.
LOCAL_AGENT_BASE_URL=
LOCAL_AGENT_MODEL=
LLM_API_KEY=

WECHAT_APP_ID=
WECHAT_APP_SECRET=

